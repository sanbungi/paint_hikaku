#!/bin/sh
set -eu
app_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export LD_LIBRARY_PATH="$app_dir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# Fontconfig 2.13 resolves relative font directories against the launch CWD.
# Generate an absolute, XML-escaped path without changing the user's CWD.
font_config_dir=$(mktemp -d "${TMPDIR:-/tmp}/paint-hikaku-fonts.XXXXXX")
trap 'rm -f -- "$font_config_dir/fonts.conf"; rmdir -- "$font_config_dir"' EXIT
xml_font_dir=$(printf '%s' "$app_dir/usr/bin/fonts" | sed 's/\&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')
printf '<?xml version="1.0"?><fontconfig><dir>%s</dir><cachedir prefix="xdg">fontconfig</cachedir></fontconfig>\n' "$xml_font_dir" > "$font_config_dir/fonts.conf"
export FONTCONFIG_FILE="$font_config_dir/fonts.conf"
unset FONTCONFIG_SYSROOT
"$app_dir/usr/bin/paint_hikaku" "$@"
